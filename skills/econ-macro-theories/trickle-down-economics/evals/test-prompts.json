{
  "skill": "trickle-down-economics",
  "version": "v0.x-draft",
  "tests": [
    {
      "id": "trickle-down-economics-should-01",
      "type": "should_trigger",
      "prompt": "给企业主减税，好处会流到工人",
      "expect": "触发 涓滴经济学：匹配典型宏观分析意图。"
    },
    {
      "id": "trickle-down-economics-should-02",
      "type": "should_trigger",
      "prompt": "增长会自动解决分配",
      "expect": "触发 涓滴经济学。"
    },
    {
      "id": "trickle-down-economics-decoy-01",
      "type": "should_not_trigger",
      "prompt": "这道微观定价题怎么用供需做？",
      "expect": "不触发或应分流：严肃的最优税制实证讨论被情绪词替掉——回到弹性与归宿"
    },
    {
      "id": "trickle-down-economics-edge-01",
      "type": "edge_case",
      "prompt": "涓滴经济学在什么情况下会失效？给我边界。",
      "expect": "触发但必须讲述边界与误用，不得声称万能。"
    },
    {
      "id": "trickle-down-economics-trap-01",
      "type": "correctness_trap",
      "prompt": "当自动真理是对的吧？",
      "expect": "必须纠正常见误用：当自动真理 — 无渠道证据仍坚持。"
    }
  ]
}

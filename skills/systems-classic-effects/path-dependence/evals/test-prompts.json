{
  "skill": "path-dependence",
  "version": "v1.0",
  "tests": [
    {
      "id": "pd-should-01",
      "type": "should_trigger",
      "prompt": "公司核心库谁都不敢换，是不是路径依赖？",
      "expect": "触发；点名强化机制与切换成本。"
    },
    {
      "id": "pd-should-02",
      "type": "should_trigger",
      "prompt": "为什么QWERTY还能用？",
      "expect": "触发；协调/学习效应，避免武断最差锁定。"
    },
    {
      "id": "pd-should-03",
      "type": "should_trigger",
      "prompt": "标准被劣解占住了怎么解锁？",
      "expect": "触发；设计双轨/过渡等解锁。"
    },
    {
      "id": "pd-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "都已经投入两千万了不甘心停。",
      "expect": "不触发主模型；走沉没成本。"
    },
    {
      "id": "pd-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "今天待办先做啥？",
      "expect": "不触发；走艾森豪威尔。"
    },
    {
      "id": "pd-decoy-01",
      "type": "should_not_trigger",
      "prompt": "只是懒得改闹钟习惯。",
      "expect": "不触发主模型；无报酬递增则不必上锁定理论。"
    },
    {
      "id": "pd-trap-01",
      "type": "correctness_trap",
      "prompt": "凡是历史造成的都叫路径依赖。",
      "expect": "纠正；必须指出可检验强化机制。"
    },
    {
      "id": "pd-trap-02",
      "type": "correctness_trap",
      "prompt": "有路径依赖就只能认命。",
      "expect": "纠正；可设计解锁。"
    },
    {
      "id": "pd-edge-01",
      "type": "edge_case",
      "prompt": "物理定律限制算路径依赖吗？",
      "expect": "否；硬约束走第一性原理。"
    },
    {
      "id": "pd-edge-02",
      "type": "edge_case",
      "prompt": "和局部最优什么关系？",
      "expect": "触发连用；依赖解释山谷深度。"
    }
  ]
}
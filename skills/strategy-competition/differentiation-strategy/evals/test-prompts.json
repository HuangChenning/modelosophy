      "expect": "触发。"
    },
    {
      "id": "differentiation-strategy-decoy-01",
      "type": "should_not_trigger",
      "prompt": "只要一句心智定位语。",
      "expect": "分流定位。"
    },
    {
      "id": "differentiation-strategy-edge-01",
      "type": "edge_case",
      "prompt": "买方只比价且规格透明？",
      "expect": "边界：难成立。"
    },
    {
      "id": "differentiation-strategy-trap-01",
      "type": "correctness_trap",

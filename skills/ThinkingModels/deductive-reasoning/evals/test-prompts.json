{
  "skill": "deductive-reasoning",
  "version": "v1.0",
  "tests": [
    {
      "id": "dr-should-01",
      "type": "should_trigger",
      "prompt": "用三段论检查这段话是否必然推出结论。",
      "expect": "触发；有效性检验。"
    },
    {
      "id": "dr-should-02",
      "type": "should_trigger",
      "prompt": "大前提小前提写好了，结论一定对吗？",
      "expect": "触发；区分有效与可靠。"
    },
    {
      "id": "dr-should-03",
      "type": "should_trigger",
      "prompt": "按合同条款演绎，他是否必须被取消资格？",
      "expect": "触发；规则蕴含。"
    },
    {
      "id": "dr-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "行业都这么报价，能不能从原材料第一性原理重算？",
      "expect": "不触发主模型；走第一性原理。"
    },
    {
      "id": "dr-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "苏格拉底式帮我质疑一下这个主张。",
      "expect": "不触发；走苏格拉底。"
    },
    {
      "id": "dr-decoy-01",
      "type": "should_not_trigger",
      "prompt": "论证中间好像缺了一句没写的前提。",
      "expect": "不触发主模型；走隐含前提。"
    },
    {
      "id": "dr-trap-01",
      "type": "correctness_trap",
      "prompt": "演绎就是逆向推理，像福尔摩斯那样猜。",
      "expect": "纠正；演绎≠溯因/侦探猜真相。"
    },
    {
      "id": "dr-trap-02",
      "type": "correctness_trap",
      "prompt": "形式有效所以结论为真。",
      "expect": "纠正；前提假则不可靠。"
    },
    {
      "id": "dr-edge-01",
      "type": "edge_case",
      "prompt": "从少数样本说所有天鹅皆白，算演绎吗？",
      "expect": "否；那是归纳。"
    },
    {
      "id": "dr-edge-02",
      "type": "edge_case",
      "prompt": "应然前提推出应然结论就结束了？",
      "expect": "形式可有效，规范前提仍需单独辩护。"
    }
  ]
}

{
  "skill": "redundancy",
  "version": "v1.0",
  "tests": [
    {
      "id": "rd-should-01",
      "type": "should_trigger",
      "prompt": "核心库只有一台机器，怎么设计备份和冗余？",
      "expect": "触发；单点、冗余类型、演练切换。"
    },
    {
      "id": "rd-should-02",
      "type": "should_trigger",
      "prompt": "N+1 和双活有什么区别？",
      "expect": "触发；解释冗余形态与切换。"
    },
    {
      "id": "rd-should-03",
      "type": "should_trigger",
      "prompt": "关键流程别把鸡蛋放一个篮子，怎么系统化？",
      "expect": "触发；失效定义与共因。"
    },
    {
      "id": "rd-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "怎么配置暴露，让波动反而让我更强？",
      "expect": "不触发；走 antifragility。"
    },
    {
      "id": "rd-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "系统里哪个杠杆点撬动最大？",
      "expect": "不触发；走 leverage。"
    },
    {
      "id": "rd-decoy-01",
      "type": "should_not_trigger",
      "prompt": "帮我画反馈回路和存量流量。",
      "expect": "不触发；走 systems-thinking。"
    },
    {
      "id": "rd-trap-01",
      "type": "correctness_trap",
      "prompt": "冗余就是反脆弱。",
      "expect": "纠正；容错/强韧 vs 从波动获益。"
    },
    {
      "id": "rd-trap-02",
      "type": "correctness_trap",
      "prompt": "多买几台一模一样的机器就绝对安全。",
      "expect": "纠正；共因故障。"
    },
    {
      "id": "rd-edge-01",
      "type": "edge_case",
      "prompt": "创业第一周就要异地双活吗？",
      "expect": "边界；成本敏感时可接受失效。"
    },
    {
      "id": "rd-edge-02",
      "type": "edge_case",
      "prompt": "备份从未演练切换，算有冗余吗？",
      "expect": "指出未验证备份≈无效。"
    }
  ]
}

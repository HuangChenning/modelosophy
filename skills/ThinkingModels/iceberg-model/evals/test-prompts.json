{
  "skill": "iceberg-model",
  "version": "v1.0",
  "tests": [
    {
      "id": "ib-should-01",
      "type": "should_trigger",
      "prompt": "口号改了行为没变，是不是文化冰山下层假设没动？",
      "expect": "触发；Schein 分层。"
    },
    {
      "id": "ib-should-02",
      "type": "should_trigger",
      "prompt": "用 artifacts / values / assumptions 拆一下我们团队。",
      "expect": "触发；组织文化三层。"
    },
    {
      "id": "ib-should-03",
      "type": "should_trigger",
      "prompt": "可见制度和底下默认玩法不一致怎么办？",
      "expect": "触发；对齐层级干预。"
    },
    {
      "id": "ib-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "用周哈里窗扩大开放区，收集盲区反馈。",
      "expect": "不触发主模型；走周哈里窗。"
    },
    {
      "id": "ib-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "帮我画存量流量和增强回路。",
      "expect": "不触发；走系统思维。"
    },
    {
      "id": "ib-decoy-01",
      "type": "should_not_trigger",
      "prompt": "先讲 WHY 再讲 HOW WHAT。",
      "expect": "不触发；走黄金圈。"
    },
    {
      "id": "ib-trap-01",
      "type": "correctness_trap",
      "prompt": "用萨提亚七层冰山给我做心理诊断。",
      "expect": "拒绝；本 skill 非临床诊断工具。"
    },
    {
      "id": "ib-trap-02",
      "type": "correctness_trap",
      "prompt": "第一步就告诉我他潜意识渴望什么。",
      "expect": "纠正；先描述可见行为，禁止读心。"
    },
    {
      "id": "ib-edge-01",
      "type": "edge_case",
      "prompt": "单一明确的配置错误导致宕机。",
      "expect": "边界；直接排障，勿文化化。"
    },
    {
      "id": "ib-edge-02",
      "type": "edge_case",
      "prompt": "基本假设怎么写才不算玄学？",
      "expect": "可证伪写法+观察检验。"
    }
  ]
}

{
  "skill": "swot",
  "version": "v1.0",
  "tests": [
    {
      "id": "sw-should-01",
      "type": "should_trigger",
      "prompt": "帮我做一份产品SWOT。",
      "expect": "触发；要比较对象、证据、TOWS匹配。"
    },
    {
      "id": "sw-should-02",
      "type": "should_trigger",
      "prompt": "机会和我们想做的事有什么差别？",
      "expect": "触发；机会须是外部条件。"
    },
    {
      "id": "sw-should-03",
      "type": "should_trigger",
      "prompt": "SWOT填完了就结束了吗？",
      "expect": "触发；要求匹配与验证行动。"
    },
    {
      "id": "sw-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "这个命题有没有自相矛盾？",
      "expect": "不触发；走苏格拉底。"
    },
    {
      "id": "sw-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "都投了三年要不要停？",
      "expect": "不触发；走沉没成本。"
    },
    {
      "id": "sw-decoy-01",
      "type": "should_not_trigger",
      "prompt": "只是排今天任务。",
      "expect": "不触发；走艾森豪威尔。"
    },
    {
      "id": "sw-trap-01",
      "type": "correctness_trap",
      "prompt": "四格形容词填满就够了。",
      "expect": "纠正；要证据、加权、匹配。"
    },
    {
      "id": "sw-trap-02",
      "type": "correctness_trap",
      "prompt": "把‘我们要做AI’写成机会。",
      "expect": "纠正；那是意图不是外部O。"
    },
    {
      "id": "sw-edge-01",
      "type": "edge_case",
      "prompt": "市场每周剧变还用静态SWOT吗？",
      "expect": "边界；需系统/情景补充。"
    },
    {
      "id": "sw-edge-02",
      "type": "edge_case",
      "prompt": "不敢写真实劣势怎么办？",
      "expect": "指出分析作废风险。"
    }
  ]
}
{
  "skill": "porters-five-forces",
  "version": "v0.9-draft",
  "tests": [
    {
      "id": "pf-should-01",
      "type": "should_trigger",
      "prompt": "我想进入本地连锁餐饮，用波特五力看行业好不好赚钱。",
      "expect": "触发；钉边界并逐力评级+证据。"
    },
    {
      "id": "pf-should-02",
      "type": "should_trigger",
      "prompt": "什么是Porter五力模型？",
      "expect": "触发；五力列表+行业层定位。"
    },
    {
      "id": "pf-should-03",
      "type": "should_trigger",
      "prompt": "买方议价和替代品威胁怎么评估？",
      "expect": "触发；给证据类型与结构含义。"
    },
    {
      "id": "pf-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "帮我们公司做SWOT，列优势劣势机会威胁。",
      "expect": "不触发主模型；走swot。"
    },
    {
      "id": "pf-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "我们凭什么能持续保有超额利润？护城河宽吗？",
      "expect": "不触发；走economic-moat。"
    },
    {
      "id": "pf-decoy-01",
      "type": "should_not_trigger",
      "prompt": "用户数平方是不是网络价值定律？",
      "expect": "不触发；走metcalfes-law。"
    },
    {
      "id": "pf-trap-01",
      "type": "correctness_trap",
      "prompt": "把‘我们执行力强’写进五力可以吗？",
      "expect": "纠正；那是公司内部因素，属SWOT。"
    },
    {
      "id": "pf-trap-02",
      "type": "correctness_trap",
      "prompt": "五力打分加总越高战略越好。",
      "expect": "纠正；力量强=利润承压；禁伪精确加总崇拜。"
    },
    {
      "id": "pf-edge-01",
      "type": "edge_case",
      "prompt": "平台正在改写行业边界，静态五力还管用吗？",
      "expect": "边界；需更新定义与情景。"
    },
    {
      "id": "pf-edge-02",
      "type": "edge_case",
      "prompt": "好行业里我们就会赚钱吗？",
      "expect": "说明；结构吸引≠公司位置，可接SWOT/护城河。"
    }
  ]
}

{
  "skill": "stock-bond-seesaw",
  "version": "v0.x-draft",
  "tests": [
    {
      "id": "stock-bond-seesaw-should-01",
      "type": "should_trigger",
      "prompt": "为什么股市跌债市却涨？",
      "expect": "触发 股债跷跷板：匹配典型分析意图。"
    },
    {
      "id": "stock-bond-seesaw-should-02",
      "type": "should_trigger",
      "prompt": "股债搭配真的分散吗？",
      "expect": "触发 股债跷跷板。"
    },
    {
      "id": "stock-bond-seesaw-decoy-01",
      "type": "should_not_trigger",
      "prompt": "请只按 modern-portfolio-theory 的框架分析，不要用 stock-bond-seesaw。",
      "expect": "不触发或应分流到兄弟 skill：modern-portfolio-theory"
    },
    {
      "id": "stock-bond-seesaw-edge-01",
      "type": "edge_case",
      "prompt": "股债跷跷板在什么情况下会失效？给我边界。",
      "expect": "触发但必须讲述边界与误用，不得声称万能。"
    },
    {
      "id": "stock-bond-seesaw-trap-01",
      "type": "correctness_trap",
      "prompt": "\"股债永远负相关\"是对的吧？",
      "expect": "必须纠正常见误用：\"股债永远负相关\" — 。"
    }
  ]
}

{
  "skill": "is-lm-model",
  "version": "v0.x-draft",
  "tests": [
    {
      "id": "is-lm-model-should-01",
      "type": "should_trigger",
      "prompt": "降息为啥能抬产出",
      "expect": "触发 IS-LM 模型：匹配典型宏观分析意图。"
    },
    {
      "id": "is-lm-model-should-02",
      "type": "should_trigger",
      "prompt": "财政扩张会不会顶高利率",
      "expect": "触发 IS-LM 模型。"
    },
    {
      "id": "is-lm-model-decoy-01",
      "type": "should_not_trigger",
      "prompt": "长期增长/资本积累",
      "expect": "不触发或应分流：长期增长/资本积累 → 索洛"
    },
    {
      "id": "is-lm-model-edge-01",
      "type": "edge_case",
      "prompt": "IS-LM 模型在什么情况下会失效？给我边界。",
      "expect": "触发但必须讲述边界与误用，不得声称万能。"
    },
    {
      "id": "is-lm-model-trap-01",
      "type": "correctness_trap",
      "prompt": "当成真实经济地图是对的吧？",
      "expect": "必须纠正常见误用：当成真实经济地图 — 忽略其教学抽象。"
    }
  ]
}

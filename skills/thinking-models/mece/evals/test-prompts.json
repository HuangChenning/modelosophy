{
  "skill": "mece",
  "version": "v1.0",
  "tests": [
    {
      "id": "mc-should-01",
      "type": "should_trigger",
      "prompt": "帮我把营收下降原因拆成不重不漏的几类。",
      "expect": "触发；钉边界、选轴、查ME/CE。"
    },
    {
      "id": "mc-should-02",
      "type": "should_trigger",
      "prompt": "分类里正方形和矩形并列，有什么问题？",
      "expect": "触发；指出ME重叠。"
    },
    {
      "id": "mc-should-03",
      "type": "should_trigger",
      "prompt": "什么是MECE？",
      "expect": "触发；解释并纠正穷尽相对边界。"
    },
    {
      "id": "mc-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "这个主张站得住吗？",
      "expect": "不触发；走苏格拉底。"
    },
    {
      "id": "mc-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "两个offer放弃哪个更亏？",
      "expect": "不触发；走机会成本。"
    },
    {
      "id": "mc-decoy-01",
      "type": "should_not_trigger",
      "prompt": "反馈回路怎么画？",
      "expect": "不触发；走系统思维。"
    },
    {
      "id": "mc-trap-01",
      "type": "correctness_trap",
      "prompt": "树很MECE所以结论一定对。",
      "expect": "纠正；MECE是结构不是真理性。"
    },
    {
      "id": "mc-trap-02",
      "type": "correctness_trap",
      "prompt": "CE是Collectively Exclusive。",
      "expect": "纠正；是Exhaustive穷尽。"
    },
    {
      "id": "mc-edge-01",
      "type": "edge_case",
      "prompt": "共病诊断能强行MECE吗？",
      "expect": "触发边界；本征重叠不宜硬拆。"
    },
    {
      "id": "mc-edge-02",
      "type": "edge_case",
      "prompt": "探索期就要先MECE冻住分类吗？",
      "expect": "纠正；过早冻结有害。"
    }
  ]
}
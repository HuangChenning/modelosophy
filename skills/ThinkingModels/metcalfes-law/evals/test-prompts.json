{
  "skill": "metcalfes-law",
  "version": "v1.0",
  "tests": [
    {
      "id": "ml-should-01",
      "type": "should_trigger",
      "prompt": "我们社群用户从100到1000，价值是不是按n²涨？",
      "expect": "触发；谈兼容有效连接与负效应，禁止裸用平方估值。"
    },
    {
      "id": "ml-should-02",
      "type": "should_trigger",
      "prompt": "什么是梅特卡夫法则？",
      "expect": "触发；潜在连接~n²启发式+边界。"
    },
    {
      "id": "ml-should-03",
      "type": "should_trigger",
      "prompt": "双边市场冷启动为什么难？和网络效应有关吗？",
      "expect": "触发；临界规模与兼容安装基数。"
    },
    {
      "id": "ml-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "这家公司凭什么能持续赚超额利润？护城河在哪？",
      "expect": "不触发主模型；走economic-moat。"
    },
    {
      "id": "ml-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "画一下我们的增长飞轮闭环。",
      "expect": "不触发；走flywheel。"
    },
    {
      "id": "ml-decoy-01",
      "type": "should_not_trigger",
      "prompt": "利滚利的再投入条件怎么检验？",
      "expect": "不触发；走compounding。"
    },
    {
      "id": "ml-trap-01",
      "type": "correctness_trap",
      "prompt": "用户数×用户数就是公司估值公式。",
      "expect": "纠正；n²非会计恒等式。"
    },
    {
      "id": "ml-trap-02",
      "type": "correctness_trap",
      "prompt": "注册账号都能算进梅特卡夫的n。",
      "expect": "纠正；需兼容且可交互的有效节点。"
    },
    {
      "id": "ml-edge-01",
      "type": "edge_case",
      "prompt": "垃圾内容和拥堵很严重时还要追求更大n吗？",
      "expect": "边界；负网络效应可主导。"
    },
    {
      "id": "ml-edge-02",
      "type": "edge_case",
      "prompt": "两条互不兼容的链，用户能加总进同一个n²吗？",
      "expect": "纠正；兼容边界分裂则不能简单加总。"
    }
  ]
}

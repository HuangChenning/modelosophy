{
  "skill": "economic-moat",
  "version": "v0.9-draft",
  "tests": [
    {
      "id": "em-should-01",
      "type": "should_trigger",
      "prompt": "这只股票ROE很高，怎么判断有没有护城河？",
      "expect": "触发；列来源、复制成本、衰减情景。"
    },
    {
      "id": "em-should-02",
      "type": "should_trigger",
      "prompt": "什么是economic moat？",
      "expect": "触发；可持续阻挡超额利润侵蚀。"
    },
    {
      "id": "em-should-03",
      "type": "should_trigger",
      "prompt": "转换成本和网络效应哪种壁垒更稳？",
      "expect": "触发；比较来源并强调证据与多宿。"
    },
    {
      "id": "em-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "这个行业平均好不好赚钱？做波特五力。",
      "expect": "不触发主模型；走porters-five-forces。"
    },
    {
      "id": "em-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "按梅特卡夫，用户平方是不是估值？",
      "expect": "不触发；走metcalfes-law。"
    },
    {
      "id": "em-decoy-01",
      "type": "should_not_trigger",
      "prompt": "给我们产品做SWOT四格。",
      "expect": "不触发；走swot。"
    },
    {
      "id": "em-trap-01",
      "type": "correctness_trap",
      "prompt": "增长很快所以一定有护城河。",
      "expect": "纠正；增长≠壁垒。"
    },
    {
      "id": "em-trap-02",
      "type": "correctness_trap",
      "prompt": "品牌响亮四个字就够证明宽护城河。",
      "expect": "纠正；需定价权/份额等证据。"
    },
    {
      "id": "em-edge-01",
      "type": "edge_case",
      "prompt": "还没利润的故事公司怎么评护城河宽度？",
      "expect": "边界；先单位经济，慎谈宽度。"
    },
    {
      "id": "em-edge-02",
      "type": "edge_case",
      "prompt": "帮我设计人生护城河投资级结论。",
      "expect": "弱隐喻可谈；拒绝伪投资级结论。"
    }
  ]
}

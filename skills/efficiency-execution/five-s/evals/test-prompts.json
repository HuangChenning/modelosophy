      "expect": "触发5S步骤。"
    },
    {
      "id": "5s-should-02",
      "type": "should_trigger",
      "prompt": "五常法整理整顿怎么落地？",
      "expect": "触发。"
    },
    {
      "id": "5s-decoy-01",
      "type": "should_not_trigger",
      "prompt": "画价值流找七大浪费。",
      "expect": "分流 lean-thinking。"
    },
    {
      "id": "5s-edge-01",
      "type": "edge_case",

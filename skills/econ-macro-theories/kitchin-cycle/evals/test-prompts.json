{
  "skill": "kitchin-cycle",
  "version": "v0.x-draft",
  "tests": [
    {
      "id": "kitchin-cycle-should-01",
      "type": "should_trigger",
      "prompt": "是不是该补库存了",
      "expect": "触发 基钦周期：匹配典型宏观分析意图。"
    },
    {
      "id": "kitchin-cycle-should-02",
      "type": "should_trigger",
      "prompt": "去库结束没",
      "expect": "触发 基钦周期。"
    },
    {
      "id": "kitchin-cycle-decoy-01",
      "type": "should_not_trigger",
      "prompt": "十年 CAPEX",
      "expect": "不触发或应分流：十年 CAPEX → juglar"
    },
    {
      "id": "kitchin-cycle-edge-01",
      "type": "edge_case",
      "prompt": "基钦周期在什么情况下会失效？给我边界。",
      "expect": "触发但必须讲述边界与误用，不得声称万能。"
    },
    {
      "id": "kitchin-cycle-trap-01",
      "type": "correctness_trap",
      "prompt": "日历拜物是对的吧？",
      "expect": "必须纠正常见误用：日历拜物 — 固定 40 个月翻牌。"
    }
  ]
}

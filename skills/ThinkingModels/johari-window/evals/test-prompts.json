{
  "skill": "johari-window",
  "version": "v1.0",
  "tests": [
    {
      "id": "jw-should-01",
      "type": "should_trigger",
      "prompt": "团队互相看不透，想用周哈里窗做一次反馈工作坊。",
      "expect": "触发；四格 + 自愿边界 + 反馈/披露路径。"
    },
    {
      "id": "jw-should-02",
      "type": "should_trigger",
      "prompt": "别人说我有盲区，我怎么收集反馈扩大开放区？",
      "expect": "触发；征求具体行为例子，盲目→开放。"
    },
    {
      "id": "jw-should-03",
      "type": "should_trigger",
      "prompt": "自我披露和隐藏区在 Johari Window 里怎么用？",
      "expect": "触发；适度披露缩小隐藏区。"
    },
    {
      "id": "jw-decoy-sibling-01",
      "type": "should_not_trigger",
      "prompt": "我考试总高估自己百分位，是不是邓克效应？",
      "expect": "不抢主模型；走 dunning-kruger。"
    },
    {
      "id": "jw-decoy-sibling-02",
      "type": "should_not_trigger",
      "prompt": "会议里事实情绪风险搅在一起怎么开？",
      "expect": "不触发；走 six-thinking-hats。"
    },
    {
      "id": "jw-decoy-01",
      "type": "should_not_trigger",
      "prompt": "这个主张自己站得住吗？帮我追问到矛盾。",
      "expect": "不触发；走 socratic-questioning。"
    },
    {
      "id": "jw-trap-01",
      "type": "correctness_trap",
      "prompt": "未知区就是潜意识，开会必须挖童年创伤。",
      "expect": "纠正；未知用小实验复盘，非临床挖掘。"
    },
    {
      "id": "jw-trap-02",
      "type": "correctness_trap",
      "prompt": "领导可以命令全员彻底坦白打开周哈里窗。",
      "expect": "纠正；强制披露破坏心理安全。"
    },
    {
      "id": "jw-edge-01",
      "type": "edge_case",
      "prompt": "用周哈里窗给同事诊断人格障碍可以吗？",
      "expect": "拒绝；非临床诊断。"
    },
    {
      "id": "jw-edge-02",
      "type": "edge_case",
      "prompt": "为了扩大开放区，把未公开的并购信息拿来分享？",
      "expect": "拒绝；合规保密优先。"
    }
  ]
}
